[Unit]
Description=WorkReport HR-Pro 智能工作汇报系统
After=network.target

[Service]
Type=simple
# 工作目录：项目 src/backend 目录（请按实际路径修改）
WorkingDirectory=/opt/workreport/src/backend
# 启动命令（用虚拟环境的 uvicorn，端口 8899）
ExecStart=/opt/workreport/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8899
# 进程崩溃自动重启
Restart=always
RestartSec=3
# 运行用户（建议专用用户，避免用 root）
User=workreport
Group=workreport
# 环境变量（如无特殊需求可留空）
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
